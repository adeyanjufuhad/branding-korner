# Copy to .env.local (or add in your hosting dashboard).

# Public site URL, used for SEO, sitemap and social previews.
# Leave unset until a domain is bought: on Vercel the *.vercel.app URL is used automatically.
NEXT_PUBLIC_SITE_URL=

# Contact form email delivery (https://resend.com, free tier is enough).
# Without a domain: sign up to Resend with brandingkorner@gmail.com, leave
# CONTACT_FROM_EMAIL unset, and set CONTACT_TO_EMAIL=brandingkorner@gmail.com.
# Resend's test sender can only deliver to the account owner's own email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=brandingkorner@gmail.com
# After buying a domain and verifying it in Resend, e.g.:
# CONTACT_FROM_EMAIL="Branding Korner <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
